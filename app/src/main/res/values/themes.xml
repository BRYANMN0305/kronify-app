<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Kronifyapp" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kronify_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Kronifyapp.Main</item>
    </style>

    <style name="Theme.Kronifyapp.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kronify_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
